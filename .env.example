# ==============================================================================
# .env.example - Template Konfigurasi Environment Deployment
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan seluruh nilainya sebelum
# menjalankan ./deploy.sh:
#   cp .env.example .env && nano .env
#
# PERINGATAN: Jangan pernah commit file .env ke repositori Git!
# Gunakan tanda kutip tunggal ('...') jika nilai mengandung karakter khusus.
# ==============================================================================

# --- Konfigurasi Aplikasi ---
APP_ENV=production
APP_USER=webapp
APP_GROUP=webapp
APP_DIR=/opt/webapp
LOG_DIR=/var/log/webapp
APP_PORT=8000
SERVER_NAME=_

# --- Konfigurasi Database (MariaDB) ---
# Wajib diisi: set DB_PASS dengan password yang kuat sebelum deploy.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webapp_db
DB_USER=webapp_user
DB_PASS=
# DB_ROOT_PASS=
